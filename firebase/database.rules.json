{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isBoolean()"
      }
    },
    "decks": {
      "codex-minipet-class-20261013": {
        "state": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['slide', 'locked', 'pdf', 'updatedAt'])",
          "slide": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 18 && newData.val() % 1 === 0" },
          "locked": { ".validate": "newData.isBoolean()" },
          "pdf": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
